[user]
	name = Luca Limardo
{{- if ne .git_email "" }}
	email = {{ .git_email }}
{{- end }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = true

[init]
	defaultBranch = main
